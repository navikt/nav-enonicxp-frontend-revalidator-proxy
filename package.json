{
  "name": "nav-enonicxp-frontend-cache-invalidator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon --watch src --ext ts --exec \"pnpm run build && node -r dotenv/config dist/app.js\"",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "nodemonConfig": {
    "delay": 500
  },
  "dependencies": {
    "express": "5.3.0",
    "pino": "10.4.0",
    "redis": "6.3.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "dotenv": "18.0.9",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}